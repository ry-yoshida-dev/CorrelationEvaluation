from typing import Literal

import numpy as np
from numpy.typing import NDArray

type _Labels = NDArray[np.int64]
type _Average = Literal["arithmetic", "geometric", "min", "max"]

def adjusted_mutual_info_score(
    labels_true: _Labels, labels_pred: _Labels, *, average_method: _Average = ...
) -> float: ...
def cohen_kappa_score(
    y1: _Labels, y2: _Labels, *, weights: Literal["linear", "quadratic"] | None = ...
) -> float: ...
def matthews_corrcoef(y_true: _Labels, y_pred: _Labels) -> float: ...
def mutual_info_score(labels_true: _Labels, labels_pred: _Labels) -> float: ...
def normalized_mutual_info_score(
    labels_true: _Labels, labels_pred: _Labels, *, average_method: _Average = ...
) -> float: ...
